<?xml version="1.0"?>
<sdf version="1.8">
  <world name="retail_store">
    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background><shadows>false</shadows></scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14.0 10.0 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14.0 10.0 0.1</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="wall_north"><static>true</static><pose>0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14.0 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14.0 0.1 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="wall_south"><static>true</static><pose>0 -5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14.0 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14.0 0.1 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link></model>
    <model name="wall_east"><static>true</static><pose>7.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10.0 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="wall_west"><static>true</static><pose>-7.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10.0 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="shelf_a"><static>true</static><pose>1.0 1.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.0 0.5 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 0.5 1.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="shelf_b"><static>true</static><pose>1.0 -1.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.0 0.5 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 0.5 1.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="shelf_c"><static>true</static><pose>-2.5 3.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.5 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.5 1.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="crate_1"><static>true</static><pose>-3.0 -2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="crate_2"><static>true</static><pose>5.5 3.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.6</size></box></geometry><material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>model://retail_textures/textures/noise.png</albedo_map><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link></model>
    <model name="pillar_1"><static>true</static><pose>-1.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link></model>
    <model name="pillar_2"><static>true</static><pose>5.5 -3.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
